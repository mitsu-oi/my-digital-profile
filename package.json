{
  "name": "my-digital-profile",
  "version": "0.1.0",
  "private": true,
  "description": "ОсьЯ — «Мій цифровий профіль»: конструктор портфоліо у стилі цифрового посвідчення",
  "scripts": {
    "build:pages": "node scripts/build-pages.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/site.css --minify",
    "build": "npm run build:art && npm run build:pages && npm run build:css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/site.css --watch",
    "serve": "node scripts/serve.js",
    "build:art": "node scripts/make-art.js",
    "build:og": "node scripts/make-og.js",
    "check": "node scripts/check-site.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
